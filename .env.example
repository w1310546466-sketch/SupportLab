# SupportLab DeepSeek configuration example. Never put a real key in this example.
# Copy to .env.local. 'agent' and 'check-model-config' load it; mock commands do not.
DEEPSEEK_API_KEY=
# Official DeepSeek endpoint. The loader accepts this URL or its /v1 form.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current tested model; an empty value uses this default.
DEEPSEEK_MODEL=deepseek-flash
